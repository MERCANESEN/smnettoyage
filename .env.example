# Copy to `.env.local` and fill in your Hostinger (or other) SMTP details.

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@smnettoyage.ch
SMTP_PASS=your-email-password
SMTP_FROM=info@smnettoyage.ch

# Where form submissions are delivered
CONTACT_TO_EMAIL=info@smnettoyage.ch

# Google Reviews (Places API — real customer reviews)
# 1) Create a Google Cloud project + enable Places API (New)
# 2) Create an API key restricted to Places API
# 3) Find your Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
# Optional public Maps link shown on the site
NEXT_PUBLIC_GOOGLE_MAPS_URL=
